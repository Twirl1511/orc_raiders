  - _tagType: 6
    _displayName: "\u0416\u0435\u0440\u0442\u0432\u0430"
    _description: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442 \u043B\u0438\u0447\u043D\u043E\u0439
      \u0432\u044B\u0433\u043E\u0434\u044B, \u043F\u0440\u0438\u043D\u044F\u0442\u044C
      \u0443\u0440\u043E\u043D \u0438\u043B\u0438 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C
      \u0440\u0435\u0441\u0443\u0440\u0441 \u0440\u0430\u0434\u0438 \u0434\u0440\u0443\u0433\u0438\u0445."
  - _tagType: 7
    _displayName: "\u042D\u0433\u043E\u0438\u0437\u043C"
    _description: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432\u044B\u0433\u043E\u0434\u043D\u043E
      \u0433\u0435\u0440\u043E\u044E \u043B\u0438\u0447\u043D\u043E, \u043D\u043E
      \u043C\u043E\u0436\u0435\u0442 \u0432\u0440\u0435\u0434\u0438\u0442\u044C \u043F\u0430\u0440\u0442\u0438\u0438,
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438 \u0438\u043B\u0438 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438."
  - _tagType: 8
    _displayName: "\u0421\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435"
    _description: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432\u043B\u0438\u044F\u0435\u0442
      \u043D\u0430 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F, \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044E,
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u0438\u043B\u0438
