  - _tagType: 2
    _displayName: "\u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C"
    _description: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441\u043D\u0438\u0436\u0430\u0435\u0442
      \u0440\u0438\u0441\u043A, \u0443\u0432\u043E\u0434\u0438\u0442 \u043E\u0442
