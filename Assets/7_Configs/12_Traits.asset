      \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C \u0443\u0433\u0440\u043E\u0437\u0443."
  - _tagType: 3
    _displayName: "\u0411\u043E\u0439"
    _description: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u043E
      \u0441 \u043F\u0440\u044F\u043C\u044B\u043C \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435\u043C,
      \u0430\u0442\u0430\u043A\u043E\u0439 \u0438\u043B\u0438 \u0443\u0447\u0430\u0441\u0442\u0438\u0435\u043C
