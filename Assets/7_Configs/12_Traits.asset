  - _tagType: 5
    _displayName: "\u0414\u043E\u0431\u044B\u0447\u0430"
    _description: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043E\u0431\u0435\u0449\u0430\u0435\u0442
      \u0437\u043E\u043B\u043E\u0442\u043E, \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B,
      \u043A\u043E\u0441\u0442\u0438, \u0440\u0435\u0441\u0443\u0440\u0441\u044B
      \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u0443\u044E \u043B\u0438\u0447\u043D\u0443\u044E
