      \u043F\u0430\u0440\u0442\u0438\u0438."
  - _tagType: 9
    _displayName: "\u041F\u0443\u0442\u044C"
    _description: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u043E
      \u0441 \u0434\u043E\u0440\u043E\u0433\u043E\u0439, \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u043C,
      \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u043E\u0439 \u043F\u0443\u0442\u0438
