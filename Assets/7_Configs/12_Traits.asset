  - _tagType: 4
    _displayName: "\u0417\u0430\u0449\u0438\u0442\u0430"
    _description: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430, \u043F\u0430\u0440\u0442\u0438\u044E,
      \u0442\u0430\u0432\u0435\u0440\u043D\u0443 \u0438\u043B\u0438 \u0432\u0430\u0436\u043D\u044B\u0439
