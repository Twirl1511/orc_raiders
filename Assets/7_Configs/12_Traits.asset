  - _tagType: 12
    _displayName: "\u041F\u043E\u043B\u044C\u0437\u0430 \u0433\u0438\u043B\u044C\u0434\u0438\u0438"
    _description: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043F\u043E\u043B\u0435\u0437\u043D\u043E
