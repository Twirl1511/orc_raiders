      \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0438."
  - _tagType: 10
    _displayName: "\u041E\u0442\u0434\u044B\u0445"
    _description: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u043E
      \u0441 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435\u043C,
      \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435\u043C, \u043B\u0435\u0447\u0435\u043D\u0438\u0435\u043C
