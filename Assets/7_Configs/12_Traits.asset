  _actionTags:
  - _tagType: 1
    _displayName: "\u0420\u0438\u0441\u043A"
    _description: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043C\u043E\u0436\u0435\u0442
